          40
        ]
      },
      "output": 0
    },
    {
      "input": {
        "quotes": [
          25,
          10,
          11
        ]
      },
      "output": 15
    },
    {
      "input": {
        "quotes": [
          90,
          90,
          90
        ]
      },
      "output": 0
    }
